{
  "dependencies": {
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "joi": "^17.12.3",
    "pako": "^2.1.0",
    "pdf-parse": "^1.1.1",
    "socket.io": "^4.7.5"
  },
  "name": "quizzle",
  "description": "A free, open source and self hosted quiz platform for schools",
  "version": "2.6.3",
  "main": "index.js",
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "scripts": {
    "test": "node --test webui/tests/*.test.js",
    "start": "bun server/index.js",
    "dev:server": "bun --watch --ignore=data/** server/index.js",
    "dev:client": "cd webui && bun run dev",
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:client\""
  },
